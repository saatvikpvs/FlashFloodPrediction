# Backend API base URL (defaults to http://localhost:8000 if unset)
VITE_API_BASE_URL=http://localhost:8000

# OpenRouteService API key, used for real road-following evacuation routes
# that reroute around High/Severe villages (frontend/src/utils/orsRouting.js).
# Get a free key at https://openrouteservice.org/dev/#/signup
# Without this, evacuation routes silently fall back to the static
# straight-line waypoints in frontend/src/data/evacuationRoutes.js -- the
# map still works, but routes are never "live" or dynamically re-routed.
VITE_ORS_API_KEY=your_openrouteservice_api_key_here
