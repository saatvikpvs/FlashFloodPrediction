# Fast2SMS API Credentials
# Get your API key from https://www.fast2sms.com/dashboard/dev-api
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Emergency alert contacts, per village (10 digits, comma-separated, without +91).
# The "SEND ALERT" button only appears for a village once it has at least one
# number configured here -- a village with its line missing/empty has no alert
# contacts and the button stays hidden for it. Add a line for every village id
# from backend/app/data/villages.py that should be alertable; this file is a
# template only (not read directly) -- put real numbers in backend/.env, which
# is gitignored.
ALERT_PHONES_CHOORALMALA=9876543210,9876543211,9876543212
ALERT_PHONES_MUNDAKKAI=9876543213,9876543214,9876543215
ALERT_PHONES_MEPPADI=9876543216
ALERT_PHONES_VYTHIRI=9876543217
ALERT_PHONES_KALPETTA=9876543218
ALERT_PHONES_MANANTHAVADY=9876543219
ALERT_PHONES_SULTHAN_BATHERY=9876543220
ALERT_PHONES_PULPALLY=9876543221